{
  "name": "leafs/s3",
  "description": "s3 module for Leaf FS",
  "keywords": [
    "fs",
    "filesystem",
    "files",
    "leaf",
    "php",
    "framework"
  ],
  "homepage": "https://leafphp.dev/docs/utils/fs.html#using-s3",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Michael Darko",
      "email": "mickdd22@gmail.com",
      "homepage": "https://github.com/mychidarko",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Leaf\\": "src"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "leafs/fs": "^5.0",
    "aws/aws-sdk-php": "*",
    "league/flysystem-aws-s3-v3": "*"
  },
  "require-dev": {
    "pestphp/pest": "^1.21",
    "leafs/alchemy": "^5.0",
    "friendsofphp/php-cs-fixer": "*"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "alchemy": "@php vendor/bin/alchemy all",
    "test": "@php vendor/bin/alchemy test",
    "lint": "@php vendor/bin/alchemy lint",
    "fmt": "@php vendor/bin/alchemy fmt",
    "analyse": "@php vendor/bin/alchemy analyse",
    "refactor": "@php vendor/bin/alchemy refactor",
    "ci": "@php vendor/bin/alchemy ci"
  }
}
